/* ==========================================
   运动记录 - 全局样式
   现代化设计 | 翡翠绿主题
   ========================================== */

/* CSS 变量 */
page {
  --primary: #10b981;
  --primary-dark: #059669;
  --primary-light: #d1fae5;
  --gradient-start: #10b981;
  --gradient-end: #0ea5e9;
  --secondary: #6366f1;
  --accent: #f59e0b;
  --danger: #ef4444;
  --bg: #f0f2f5;
  --surface: #ffffff;
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --text-muted: #94a3b8;
  --border: #e2e8f0;
  --shadow-sm: 0 1rpx 3rpx rgba(0,0,0,0.04);
  --shadow-md: 0 4rpx 20rpx rgba(0,0,0,0.06);
  --shadow-lg: 0 8rpx 32rpx rgba(0,0,0,0.10);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 40rpx;

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--text-primary);
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ========== 容器 ========== */
.container {
  padding: 24rpx 32rpx;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* ========== 卡片 ========== */
.card {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
  transition: all 0.2s;
}

.card-header {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-header-icon {
  width: 48rpx;
  height: 48rpx;
  background: var(--primary-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* ========== 按钮 ========== */
.btn-primary {
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  color: #ffffff;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
  border: none;
  transition: all 0.2s;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.35);
}

.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-primary[disabled] {
  background: #e2e8f0;
  color: #94a3b8;
  box-shadow: none;
}

.btn-outline {
  height: 80rpx;
  line-height: 80rpx;
  background: var(--surface);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  font-weight: 500;
  padding: 0 32rpx;
  transition: all 0.2s;
}

.btn-outline:active {
  background: var(--primary-light);
}

.btn-danger {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--surface);
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
  padding: 0;
  transition: all 0.2s;
}

.btn-danger:active {
  background: #fef2f2;
}

.btn-sm {
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.form-label-sm {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f8fafc;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: var(--primary);
  background: #ffffff;
}

.form-row {
  display: flex;
  gap: 24rpx;
}

.form-half {
  flex: 1;
}

.picker-value {
  height: 88rpx;
  background: #f8fafc;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* ========== 浮动按钮 ========== */
.fab {
  position: fixed;
  bottom: 120rpx;
  right: 40rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.45);
  z-index: 100;
  transition: all 0.2s;
}

.fab:active {
  transform: scale(0.92);
}

.fab-text {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 200;
  line-height: 1;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 180rpx;
}

.empty-icon {
  font-size: 128rpx;
  margin-bottom: 32rpx;
  opacity: 0.8;
  animation: float 3s ease-in-out infinite;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

/* ========== 弹窗模态 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.modal-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx 80rpx;
  z-index: 201;
  max-height: 80vh;
  overflow-y: auto;
  animation: slideUp 0.25s ease-out;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btns .btn-outline { flex: 1; }
.modal-btns .btn-primary { flex: 2; }

.modal-close {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
  margin-top: 24rpx;
  padding: 12rpx;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* ========== Toast / 标签 ========== */
.badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.badge-green {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.badge-purple {
  background: #ede9fe;
  color: #7c3aed;
}

.badge-amber {
  background: #fef3c7;
  color: #d97706;
}

/* ========== 分割线 ========== */
.divider {
  height: 2rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* ========== 提示文字 ========== */
.section-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
  line-height: 1.5;
}

/* ========== 数据信息 ========== */
.data-info {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}

.data-count {
  color: var(--primary);
  font-weight: 700;
}
