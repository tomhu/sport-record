/* ===== 登录页 ===== */
page {
  background: linear-gradient(160deg, #ecfdf5 0%, #f0f9ff 100%);
}

.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 80rpx 48rpx 60rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.login-app-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  display: block;
}

.login-app-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 8rpx;
  display: block;
}

.login-app-desc {
  font-size: 26rpx;
  color: #94a3b8;
  display: block;
}

/* ===== 头像 ===== */
.avatar-section {
  text-align: center;
  margin-bottom: 48rpx;
}

.avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.25);
}

.avatar-text {
  font-size: 72rpx;
}

.avatar-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

/* ===== 表单 ===== */
.login-form {
  width: 100%;
  margin-bottom: 40rpx;
}

.login-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.login-input-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 96rpx;
  border: 2rpx solid #e2e8f0;
  transition: border-color 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.login-input-wrap:focus-within {
  border-color: #10b981;
}

.login-input {
  flex: 1;
  font-size: 30rpx;
  color: #1e293b;
  height: 100%;
  background: transparent;
  border: none;
  outline: none;
}

.login-input::placeholder {
  color: #cbd5e1;
}

.login-input-clear {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 8rpx;
}

/* ===== 用户列表（多用户场景） ===== */
.user-list-section {
  width: 100%;
  margin-bottom: 40rpx;
}

.user-list-title {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
  display: block;
}

.user-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.user-chip:active {
  transform: scale(0.96);
}

.user-chip-avatar {
  font-size: 32rpx;
}

.user-chip-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.user-chip-admin {
  font-size: 20rpx;
  color: #f59e0b;
  background: #fef3c7;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

/* ===== 按钮 ===== */
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #10b981, #0ea5e9);
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0;
  box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.35);
  border: none;
  margin-bottom: 24rpx;
}

.login-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.login-skip {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 16rpx;
}

.login-skip:active {
  color: #64748b;
}

/* ===== 底部 ===== */
.login-footer {
  margin-top: auto;
  text-align: center;
  font-size: 22rpx;
  color: #cbd5e1;
}

.login-footer text {
  display: block;
  margin-bottom: 4rpx;
}
