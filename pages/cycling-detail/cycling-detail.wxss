.detail-page {
  min-height: 100vh;
  background: #f0f2f5;
}

/* ===== 地图 ===== */
.map-section {
  position: relative;
  width: 100%;
  height: 480rpx;
}

.detail-map {
  width: 100%;
  height: 100%;
}

.map-actions {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
}

.map-action-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}

.map-action-icon {
  font-size: 36rpx;
  color: #334155;
}

.map-action-btn:active {
  background: #f1f5f9;
}

/* ===== 内容区 ===== */
.detail-content {
  padding: 24rpx 32rpx 60rpx;
}

/* ===== 4项统计 ===== */
.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.s-emoji { display: block; font-size: 32rpx; margin-bottom: 6rpx; }
.s-value { display: block; font-size: 36rpx; font-weight: 800; color: #1e293b; line-height: 1.2; margin-bottom: 4rpx; }
.s-label { display: block; font-size: 22rpx; color: #94a3b8; }

/* ===== 图表 ===== */
.chart-card {
  padding: 28rpx 24rpx 24rpx;
  margin-bottom: 24rpx;
}

.chart-header {
  margin-bottom: 18rpx;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.chart-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
}

.canvas-el {
  display: block;
  width: 620rpx;
  height: 280rpx;
}

/* ===== 信息行 ===== */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.info-row:last-child { border-bottom: none; }

.info-label { font-size: 26rpx; color: #64748b; }
.info-value { font-size: 26rpx; font-weight: 600; color: #1e293b; }
