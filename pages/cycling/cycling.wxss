/* ===== 全屏布局 ===== */
.cycling-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

/* ===== 全屏地图 ===== */
.cycling-map {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

/* ===== 顶部状态栏（隐藏，功能合并到码表面板） ===== */
.top-bar {
  display: none;
}

/* ===== 实时数据面板 - 码表风格 ===== */
.stats-panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 33.34vh;
  min-height: 420rpx;
  background: #0f172a;
  z-index: 20;
  padding-top: env(safe-area-inset-top);
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.5);
}

/* 顶部标题行 */
.stats-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 8rpx;
}

.stats-header-back {
  font-size: 36rpx;
  color: #94a3b8;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
}

.stats-header-title {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.stats-header-status {
  font-size: 22rpx;
  color: #64748b;
}

.stats-header-status-active {
  color: #10b981 !important;
}

.stats-header-status-paused {
  color: #f59e0b !important;
}

/* 主数据区 */
.stats-main-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 40rpx 0;
  flex: 1;
}

.stats-main-item {
  text-align: center;
  flex: 1;
}

.stats-main-big {
  flex: 1.6;
}

.main-value {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #e2e8f0;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.main-value-big {
  display: block;
  font-size: 108rpx;
  font-weight: 900;
  color: #10b981;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 40rpx rgba(16,185,129,0.35);
}

.main-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 副数据区 */
.stats-sub-row {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 24rpx 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.08);
}

.sub-item {
  text-align: center;
  min-width: 0;
  flex: 1;
}

.sub-icon {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.sub-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #cbd5e1;
  margin: 0 4rpx;
  font-variant-numeric: tabular-nums;
}

.sub-label {
  font-size: 18rpx;
  color: #475569;
  display: block;
  margin-top: 2rpx;
}

/* ===== 心率样式 ===== */
.sub-item-hr .sub-icon {
  animation: hrPulse 1s ease-in-out infinite;
}

.sub-value-hr {
  color: #ef4444 !important;
  text-shadow: 0 0 16rpx rgba(239,68,68,0.4);
}

.sub-value-hr-off {
  color: #334155 !important;
}

.sub-value-hr-connecting {
  color: #f59e0b !important;
  letter-spacing: 2rpx;
}

@keyframes hrPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

/* 结束弹窗心率行 */
.finish-stat-hr {
  background: #fef2f2;
  border-radius: 12rpx;
}

.finish-stat-hr-val {
  color: #ef4444 !important;
}

/* ===== 控制栏 ===== */
.ctrl-bar {
  position: absolute;
  bottom: 80rpx;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 开始按钮 */
.btn-start-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  padding: 28rpx 64rpx;
  border-radius: 60rpx;
  box-shadow: 0 8rpx 32rpx rgba(16,185,129,0.5);
}

.btn-start-wrap:active {
  transform: scale(0.95);
}

.btn-start-icon {
  font-size: 32rpx;
  color: #fff;
}

.btn-start-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

/* 追踪控制 */
.ctrl-tracking {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.btn-ctrl {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.btn-ctrl:active {
  opacity: 0.7;
}

.btn-ctrl-icon {
  font-size: 48rpx;
  color: #fff;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: rgba(0,0,0,0.4);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
}

.btn-ctrl-text {
  font-size: 22rpx;
  color: #fff;
}

.btn-pause-wrap,
.btn-resume-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(245,158,11,0.5);
}

.btn-pause-wrap:active,
.btn-resume-wrap:active {
  transform: scale(0.93);
}

.btn-pause-icon,
.btn-resume-icon {
  font-size: 56rpx;
  color: #fff;
}

/* GPS 警告 */
.gps-warning {
  margin-top: 20rpx;
  padding: 12rpx 32rpx;
  background: rgba(239,68,68,0.85);
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
}

.gps-warning text {
  font-size: 24rpx;
  color: #fff;
}

/* ===== 结束弹窗 ===== */
.finish-modal {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 48rpx 32rpx 80rpx;
  z-index: 210;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.finish-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #1e293b;
  text-align: center;
  margin-bottom: 32rpx;
}

.finish-stats {
  margin-bottom: 36rpx;
}

.finish-stat-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.finish-stat-label {
  font-size: 26rpx;
  color: #64748b;
}

.finish-stat-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.finish-btns {
  display: flex;
  gap: 24rpx;
}

.finish-btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f1f5f9;
  color: #64748b;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
  border: none;
}

.finish-btn-save {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(16,185,129,0.4);
}
