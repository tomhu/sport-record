/* ===== 全屏布局 ===== */
.cycling-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

/* ===== 全屏地图 ===== */
.cycling-map {
  width: 100%;
  height: 100%;
}

/* ===== 顶部状态栏 ===== */
.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding-top: env(safe-area-inset-top);
}

.top-bar-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.4), transparent);
}

.top-status {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  gap: 16rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: rgba(0,0,0,0.3);
  border-radius: 50%;
}

.top-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

/* ===== 实时数据面板 ===== */
.stats-panel {
  position: absolute;
  top: 160rpx;
  left: 32rpx;
  right: 32rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  z-index: 10;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.12);
}

.stats-main-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.stats-main-item {
  text-align: center;
  flex: 1;
}

.stats-main-big {
  flex: 1.5;
}

.main-value {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #1e293b;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.main-value-big {
  display: block;
  font-size: 64rpx;
  font-weight: 900;
  color: #10b981;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.main-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.stats-sub-row {
  display: flex;
  justify-content: space-around;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
}

.sub-item {
  text-align: center;
}

.sub-icon {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.sub-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
  margin: 0 4rpx;
}

.sub-label {
  font-size: 20rpx;
  color: #94a3b8;
}

/* ===== 控制栏 ===== */
.ctrl-bar {
  position: absolute;
  bottom: 80rpx;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 开始按钮 */
.btn-start-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  padding: 28rpx 64rpx;
  border-radius: 60rpx;
  box-shadow: 0 8rpx 32rpx rgba(16,185,129,0.5);
}

.btn-start-wrap:active {
  transform: scale(0.95);
}

.btn-start-icon {
  font-size: 32rpx;
  color: #fff;
}

.btn-start-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

/* 追踪控制 */
.ctrl-tracking {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.btn-ctrl {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.btn-ctrl:active {
  opacity: 0.7;
}

.btn-ctrl-icon {
  font-size: 48rpx;
  color: #fff;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: rgba(0,0,0,0.4);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
}

.btn-ctrl-text {
  font-size: 22rpx;
  color: #fff;
}

.btn-pause-wrap,
.btn-resume-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(245,158,11,0.5);
}

.btn-pause-wrap:active,
.btn-resume-wrap:active {
  transform: scale(0.93);
}

.btn-pause-icon,
.btn-resume-icon {
  font-size: 56rpx;
  color: #fff;
}

/* GPS 警告 */
.gps-warning {
  margin-top: 20rpx;
  padding: 12rpx 32rpx;
  background: rgba(239,68,68,0.85);
  border-radius: 24rpx;
  backdrop-filter: blur(10rpx);
}

.gps-warning text {
  font-size: 24rpx;
  color: #fff;
}

/* ===== 结束弹窗 ===== */
.finish-modal {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 48rpx 32rpx 80rpx;
  z-index: 210;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.finish-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #1e293b;
  text-align: center;
  margin-bottom: 32rpx;
}

.finish-stats {
  margin-bottom: 36rpx;
}

.finish-stat-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.finish-stat-label {
  font-size: 26rpx;
  color: #64748b;
}

.finish-stat-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.finish-btns {
  display: flex;
  gap: 24rpx;
}

.finish-btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f1f5f9;
  color: #64748b;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
  border: none;
}

.finish-btn-save {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(16,185,129,0.4);
}
