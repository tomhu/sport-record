<view class="container">

  <!-- ===== 页面标题 + 周期切换 ===== -->
  <view class="page-header">
    <text class="page-title">📊 运动统计</text>
  </view>

  <view class="period-tabs">
    <view
      wx:for="{{periodList}}"
      wx:key="key"
      class="period-tab {{period === item.key ? 'period-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onPeriodChange"
    >
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- ===== 空状态 ===== -->
  <view wx:if="{{loaded && !hasData}}" class="empty-state">
    <view class="empty-icon">📉</view>
    <view class="empty-title">暂无数据</view>
    <view class="empty-desc">开始运动后会在这里展示统计图表</view>
  </view>

  <!-- ===== 加载中 ===== -->
  <view wx:if="{{!loaded}}" class="loading-state">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- ===== 内容 ===== -->
  <view wx:if="{{hasData}}">

    <!-- 汇总卡片 -->
    <view class="summary-grid">
      <view class="summary-item summary-item-green">
        <text class="summary-emoji">🔥</text>
        <text class="summary-value">{{summary.calories}}</text>
        <text class="summary-label">消耗千卡</text>
      </view>
      <view class="summary-item summary-item-blue">
        <text class="summary-emoji">🕐</text>
        <text class="summary-value">{{summary.duration}}</text>
        <text class="summary-label">运动分钟</text>
      </view>
      <view class="summary-item summary-item-amber">
        <text class="summary-emoji">🏋️</text>
        <text class="summary-value">{{summary.records}}</text>
        <text class="summary-label">运动次数</text>
      </view>
      <view class="summary-item summary-item-purple">
        <text class="summary-emoji">📏</text>
        <text class="summary-value">{{summary.distance || 0}}</text>
        <text class="summary-label">公里</text>
      </view>
    </view>

    <!-- 折线图：每日消耗趋势 -->
    <view class="card chart-card">
      <view class="chart-header">
        <text class="chart-title">📈 消耗趋势</text>
        <text class="chart-subtitle">每日消耗热量变化</text>
      </view>
      <view class="chart-wrap">
        <canvas type="2d" id="lineChart" class="canvas-el"></canvas>
      </view>
    </view>

    <!-- 柱状图：运动排行 -->
    <view class="card chart-card">
      <view class="chart-header">
        <text class="chart-title">🏆 运动排行</text>
        <text class="chart-subtitle">各运动项目消耗对比</text>
      </view>
      <view class="chart-wrap">
        <canvas type="2d" id="barChart" class="canvas-el-bar"></canvas>
      </view>
    </view>

    <!-- 月度汇总 -->
    <view class="card">
      <view class="chart-header">
        <text class="chart-title">📅 月度汇总</text>
      </view>
      <view wx:if="{{monthlySummaries.length === 0}}" class="empty-mini">
        <text class="empty-mini-text">暂无月度数据</text>
      </view>
      <view class="monthly-list">
        <view wx:for="{{monthlySummaries}}" wx:key="month" class="monthly-row">
          <text class="monthly-label">{{item.month}}</text>
          <view class="monthly-stats">
            <text class="monthly-stat">{{item.records}} 次</text>
            <text class="monthly-stat">{{item.calories}} 千卡</text>
            <text class="monthly-stat">{{item.duration}} 分钟</text>
          </view>
        </view>
      </view>
    </view>

    <view style="height: 40rpx;"></view>
  </view>
</view>
