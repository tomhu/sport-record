<view class="container">

  <!-- ===== 用户信息 ===== -->
  <view class="card">
    <view class="card-header">
      <view class="card-header-icon">👤</view>
      <text>当前用户</text>
    </view>
    <view class="user-profile">
      <text class="user-avatar">{{currentUser.avatar || '🏃'}}</text>
      <view class="user-info">
        <text class="user-name">{{currentUser.name || '未登录'}}</text>
        <text wx:if="{{currentUser.isAdmin}}" class="user-badge">管理员</text>
        <text wx:if="{{!currentUser.isAdmin}}" class="user-badge user-badge-normal">普通用户</text>
      </view>
      <button class="btn-outline btn-sm" bindtap="onSwitchUser">切换</button>
    </view>
  </view>

  <!-- ===== 管理员面板 ===== -->
  <view wx:if="{{currentUser && currentUser.isAdmin}}" class="card">
    <view class="card-header">
      <view class="card-header-icon">🛡️</view>
      <text>管理员面板</text>
    </view>
    <view class="section-tip">选择要查看的数据范围</view>

    <view class="view-mode-list">
      <!-- 自己 -->
      <view class="view-mode-item {{viewMode === 'self' ? 'view-mode-active' : ''}}" bindtap="onResetView">
        <text class="view-mode-avatar">{{currentUser.avatar}}</text>
        <view class="view-mode-info">
          <text class="view-mode-name">我的记录</text>
          <text class="view-mode-desc">仅查看自己的运动数据</text>
        </view>
        <text wx:if="{{viewMode === 'self'}}" class="view-mode-check">✓</text>
      </view>

      <!-- 全部用户 -->
      <view class="view-mode-item {{viewMode === 'all' ? 'view-mode-active' : ''}}" data-userid="__all__" bindtap="onSelectViewUser">
        <text class="view-mode-avatar">👥</text>
        <view class="view-mode-info">
          <text class="view-mode-name">全部用户</text>
          <text class="view-mode-desc">查看所有用户的运动数据</text>
        </view>
        <text wx:if="{{viewMode === 'all'}}" class="view-mode-check">✓</text>
      </view>

      <!-- 各用户 -->
      <view
        wx:for="{{allUsers}}"
        wx:key="userId"
        class="view-mode-item {{viewMode === item.userId ? 'view-mode-active' : ''}}"
        data-userid="{{item.userId}}"
        bindtap="onSelectViewUser"
      >
        <text class="view-mode-avatar">{{item.avatar}}</text>
        <view class="view-mode-info">
          <text class="view-mode-name">{{item.name}}</text>
          <text class="view-mode-desc">{{item.recordCount || 0}} 条记录</text>
        </view>
        <text wx:if="{{item.isAdmin}}" class="view-mode-tag">管理</text>
        <text wx:if="{{viewMode === item.userId}}" class="view-mode-check">✓</text>
      </view>
    </view>
  </view>

  <!-- ===== 体重设置 ===== -->
  <view class="card">
    <view class="card-header">
      <view class="card-header-icon">⚖️</view>
      <text>体重设置</text>
    </view>
    <view class="weight-desc">用于计算运动消耗热量（仅影响你的记录）</view>
    <view class="weight-input-row">
      <view class="weight-input-wrap">
        <input class="form-input weight-input" type="digit" placeholder="输入体重" value="{{weight}}" bindinput="onWeightInput" />
        <text class="weight-unit">kg</text>
      </view>
      <button class="btn-primary btn-sm weight-save-btn" bindtap="onSaveWeight">保存</button>
    </view>
  </view>

  <!-- ===== 蓝牙心率设备 ===== -->
  <view class="card">
    <view class="card-header">
      <view class="card-header-icon">⌚</view>
      <text>蓝牙心率设备</text>
    </view>
    <view class="section-tip">连接支持标准心率服务(0x180D)的BLE设备，骑行时获取实时心率</view>

    <!-- 已配对设备 -->
    <view wx:if="{{bleDevice}}" class="ble-paired">
      <view class="ble-paired-info">
        <text class="ble-paired-icon">⌚</text>
        <view class="ble-paired-detail">
          <text class="ble-paired-name">{{bleDevice.name || '未知设备'}}</text>
          <text class="ble-paired-id">{{bleDevice.deviceId}}</text>
        </view>
        <view class="ble-paired-status">
          <view class="ble-status-dot ble-status-dot-green"></view>
          <text class="ble-status-text">已配对</text>
        </view>
      </view>
      <button class="btn-outline btn-sm ble-unpair-btn" bindtap="onBLEDisconnect">取消配对</button>
    </view>

    <!-- 未配对：扫描按钮 -->
    <view wx:if="{{!bleDevice}}" class="ble-scan-area">
      <button
        class="btn-outline ble-scan-btn"
        disabled="{{bleScanning || bleConnecting}}"
        bindtap="{{bleScanning ? 'onBLEStopScan' : 'onBLEScan'}}"
      >
        <text wx:if="{{!bleScanning && !bleConnecting}}">🔍 扫描心率设备</text>
        <text wx:if="{{bleScanning}}">⏳ 扫描中...点击停止</text>
        <text wx:if="{{bleConnecting}}">⏳ 正在连接...</text>
      </button>

      <!-- 扫描结果列表 -->
      <view wx:if="{{bleScanList.length > 0}}" class="ble-device-list">
        <view class="ble-device-tip">发现 {{bleScanList.length}} 个设备，点击连接</view>
        <view
          wx:for="{{bleScanList}}"
          wx:key="deviceId"
          class="ble-device-item"
          data-index="{{index}}"
          bindtap="onBLESelect"
        >
          <view class="ble-device-left">
            <text class="ble-device-icon">{{item.hasHRService ? '❤️' : '📱'}}</text>
            <view class="ble-device-info">
              <text class="ble-device-name">{{item.name}}</text>
              <text class="ble-device-id">{{item.deviceId}}</text>
            </view>
          </view>
          <view class="ble-device-right">
            <text wx:if="{{item.hasHRService}}" class="ble-hr-badge badge badge-green">心率</text>
            <text class="ble-rssi">{{item.RSSI > -60 ? '📶' : item.RSSI > -75 ? '📶' : '📡'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 运动类型管理 ===== -->
  <view class="card">
    <view class="card-header">
      <view class="card-header-icon">📋</view>
      <text>运动类型管理</text>
    </view>
    <view class="section-tip">点击「编辑」可修改 MET 值、计量方式等参数</view>
    <view class="sport-list">
      <view wx:for="{{allSports}}" wx:key="key" class="sport-list-item">
        <view class="sport-list-info">
          <text class="sport-list-icon">{{item.icon}}</text>
          <view class="sport-list-detail">
            <text class="sport-list-name">{{item.shortName}}</text>
            <text class="sport-list-meta">
              MET {{item.met}}
              <text wx:if="{{item.isCustom}}"> · 自定义</text>
              <text wx:if="{{item.isEdited && !item.isCustom}}"> · 已修改</text>
            </text>
          </view>
        </view>
        <view class="sport-list-actions">
          <text wx:if="{{item.isCustom}}" class="action-del" data-key="{{item.key}}" bindtap="onDeleteCustom">删除</text>
          <text class="action-edit" data-key="{{item.key}}" bindtap="onEditSport">编辑</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 添加自定义运动 ===== -->
  <view class="card">
    <view class="card-header">
      <view class="card-header-icon">✨</view>
      <text>添加自定义运动</text>
    </view>
    <view class="form-group">
      <view class="form-label-sm">运动名称</view>
      <input class="form-input" placeholder="如：平板支撑" value="{{customName}}" bindinput="onCustomNameInput" />
    </view>
    <view class="form-group">
      <view class="form-label-sm">Emoji 图标</view>
      <input class="form-input" placeholder="如：🧘" value="{{customIcon}}" bindinput="onCustomIconInput" maxlength="4" />
    </view>
    <view class="form-row">
      <view class="form-group form-half">
        <view class="form-label-sm">MET 值</view>
        <input class="form-input" type="digit" placeholder="如：3.0" value="{{customMet}}" bindinput="onCustomMetInput" />
      </view>
      <view class="form-group form-half">
        <view class="form-label-sm">计量方式</view>
        <picker mode="selector" range="{{['计时','计次','两者']}}" value="{{customMeasureType === 'duration' ? 0 : customMeasureType === 'count' ? 1 : 2}}" bindchange="onMeasureTypeChange">
          <view class="form-input picker-value">{{customMeasureType === 'duration' ? '计时' : customMeasureType === 'count' ? '计次' : '两者'}}</view>
        </picker>
      </view>
    </view>
    <view wx:if="{{customMeasureType === 'count' || customMeasureType === 'both'}}" class="form-group">
      <view class="form-label-sm">单次消耗 (千卡)</view>
      <input class="form-input" type="digit" placeholder="如：0.5" value="{{customKcalPerUnit}}" bindinput="onCustomKcalInput" />
    </view>
    <button class="btn-outline" bindtap="onAddCustomSport">+ 添加运动</button>
  </view>

  <!-- ===== 数据管理 ===== -->
  <view class="card">
    <view class="card-header">
      <view class="card-header-icon">🗄️</view>
      <text>数据管理</text>
    </view>
    <view class="data-info">
      全部共有 <text class="data-count">{{totalRecords}}</text> 条运动记录
    </view>
    <button class="btn-danger" bindtap="onClearRecords">清除所有记录</button>
  </view>

  <!-- ===== 关于 ===== -->
  <view class="card about-card">
    <view class="about-icon">🏃‍♂️</view>
    <view class="about-title">运动记录</view>
    <view class="about-formula">计时 · MET × 体重(kg) × 时长(h)</view>
    <view class="about-formula">距离 · 距离(km) × 体重(kg) × 每km消耗</view>
    <view class="about-formula">计次 · 次数 × 单次消耗(千卡)</view>
    <view class="about-version">v4.0.0 · 本地数据库 · 多用户</view>
  </view>

  <view style="height: 40rpx;"></view>
</view>

<!-- ========== 编辑弹窗 ========== -->
<view wx:if="{{showEditModal}}" class="modal-mask" bindtap="onCloseEdit"></view>
<view wx:if="{{showEditModal}}" class="modal-panel">
  <view class="modal-title">编辑「{{editSport.shortName}}」</view>

  <view class="form-group">
    <view class="form-label-sm">MET 值</view>
    <input class="form-input" type="digit" value="{{editMet}}" bindinput="onEditMetInput" />
  </view>

  <view class="form-group">
    <view class="form-label-sm">计量方式</view>
    <picker mode="selector" range="{{['计时','计次','两者']}}" value="{{editMeasureType === 'duration' ? 0 : editMeasureType === 'count' ? 1 : 2}}" bindchange="onEditMeasureChange">
      <view class="form-input picker-value">{{editMeasureType === 'duration' ? '计时' : editMeasureType === 'count' ? '计次' : '两者'}}</view>
    </picker>
  </view>

  <view wx:if="{{editMeasureType === 'count' || editMeasureType === 'both'}}" class="form-group">
    <view class="form-label-sm">单次消耗 (千卡)</view>
    <input class="form-input" type="digit" value="{{editKcalPerUnit}}" bindinput="onEditKcalInput" />
  </view>

  <view class="form-group">
    <view class="form-label-sm">每公里消耗 (kcal/kg/km, 0=不支持)</view>
    <input class="form-input" type="digit" value="{{editCaloriePerKm}}" bindinput="onEditCalorieKmInput" />
  </view>

  <view class="modal-btns">
    <button class="btn-outline" bindtap="onResetSportEdit">恢复默认</button>
    <button class="btn-primary" bindtap="onSaveSportEdit">保存修改</button>
  </view>
  <view class="modal-close" bindtap="onCloseEdit">取消</view>
</view>
