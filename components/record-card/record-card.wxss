.record-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.record-card:active {
  background: #f8fafc;
  border-color: #e2e8f0;
}

/* 图标圆形背景 */
.card-icon-wrap {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
}

/* 中间内容 */
.card-content {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-sport-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.card-date {
  font-size: 22rpx;
  color: #94a3b8;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.6;
}

/* 右侧卡路里 */
.card-calorie {
  text-align: right;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.calorie-val {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #10b981;
  line-height: 1.2;
  text-align: center;
}

.calorie-unit {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
  text-align: center;
}

/* 删除按钮 */
.card-delete {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #cbd5e1;
  font-size: 28rpx;
  border-radius: 50%;
  background: #f8fafc;
  opacity: 0;
  transition: opacity 0.2s;
}

.record-card:hover .card-delete,
.record-card:active .card-delete {
  opacity: 1;
}

.card-delete:active {
  background: #fef2f2;
  color: #ef4444;
  opacity: 1;
}
